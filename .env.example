# --- Core ---
APP_ENV=development
APP_NAME=AgentDock
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentdock
POSTGRES_PASSWORD=agentdock_dev_password
POSTGRES_DB=agentdock
DATABASE_URL=postgresql+asyncpg://agentdock:agentdock_dev_password@localhost:5432/agentdock

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth (Phase 2) ---
# SESSION_SECRET=replace-me-with-a-long-random-string
# AUTH_TOKEN_EXPIRE_MINUTES=1440

# --- GitHub App (Phase 3) ---
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=agentdock

# --- LLM (Phase 5) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Sandbox (Phase 4) ---
SANDBOX_PROVIDER=docker
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=3600
SANDBOX_NETWORK_MODE=bridge
