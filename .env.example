# --- Core ---
APP_ENV=development
APP_NAME=AgentDock
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- PostgreSQL ---
# Development-only host port (used with docker-compose.dev.yml) defaults to
# 5433 to avoid clashing with a local Postgres on 5432. Inside Compose the API
# still connects to hostname "postgres" on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=agentdock
POSTGRES_PASSWORD=agentdock_dev_password
POSTGRES_DB=agentdock
DATABASE_URL=postgresql+asyncpg://agentdock:agentdock_dev_password@localhost:5433/agentdock

# --- Redis ---
# Development-only host port (used with docker-compose.dev.yml) defaults to
# 6380 to avoid clashing with a local Redis on 6379. Inside Compose the API
# still connects to hostname "redis" on 6379.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Auth (Phase 2) ---
# Development-only defaults. Generate a strong secret for any shared/staging/production env.
SESSION_SECRET=dev-only-change-me-agentdock-session-secret
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=agentdock_session
# COOKIE_SECURE=true   # required in production (HTTPS)
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- GitHub App (Phase 3) ---
# Leave unset for local/dev without a GitHub App — the API still starts.
# See docs/github-app.md for setup. Never commit real secrets or .pem files.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=agentdock-dev
# GITHUB_APP_CLIENT_ID=Iv1.example
# GITHUB_APP_CLIENT_SECRET=replace-me
# Inline PEM (use \n for newlines) OR a path mounted into the API container:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=replace-with-strong-random
# GITHUB_CALLBACK_URL=http://localhost:8000/api/github/callback
# GITHUB_SETUP_URL=http://localhost:8000/api/github/setup
# GITHUB_FRONTEND_SUCCESS_URL=http://localhost:3000/github

# --- LLM / Agent (Phase 5) ---
# Soft-disable when unset. Use fake for local/CI deterministic agent loops.
# LLM_PROVIDER=fake
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# AGENT_MAX_STEPS=20
# AGENT_MAX_TOOL_CALLS=40
# AGENT_MAX_RUNTIME_SECONDS=600
# AGENT_MAX_CONTEXT_CHARS=48000
# AGENT_MAX_FILE_READ_BYTES=64000
# AGENT_MAX_DIFF_CHARS=80000
# AGENT_MAX_DIFF_PREVIEW_CHARS=80000
# AGENT_MAX_PUBLICATION_ARTIFACT_BYTES=8000000

# --- LLM (Phase 5 legacy placeholders) ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Sandbox / Worker (Phase 4) ---
# Sandboxes must never receive GitHub App private keys, DB credentials, Redis secrets, or LLM API keys.
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=agentdock-sandbox:local
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_OUTPUT_BYTES=256000
# true = no network inside sandbox (recommended). Clone happens on the worker host.
SANDBOX_NETWORK_DISABLED=true
# fixture = copy fixtures/sample-repo (default for fresh clone); github = installation-token clone on worker
SANDBOX_CHECKOUT_MODE=fixture
SANDBOX_FIXTURE_REPO_PATH=
WORKER_CONCURRENCY=2
EXECUTION_RATE_LIMIT_ATTEMPTS=10
EXECUTION_RATE_LIMIT_WINDOW_SECONDS=60
EXECUTION_MAX_ACTIVE_PER_USER=3
